 {
  "tool": "navigate",
  "args": {
   "url": "https://www.amazon.in/s?k=headphones",
   "intent": "Open Amazon search"
  }
 },
 {
  "tool": "inspect_page",
  "args": {
   "sample": "Sony WH-CH520"
  }
